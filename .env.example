SUPABASE_URL=your_supabase_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key # required for hasAccess() tier checks and the Stripe webhook
NVIDIA_API_KEY=your_nvidia_api_key
GEMINI_API_KEY=your_gemini_api_key
GHANA_NLP_API_KEY=your_ghana_nlp_key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key
# OPENFDA_API_KEY=set via wrangler secret OPENFDA_API_KEY --config .output/server/wrangler.json

# Stripe checkout (SomaCare Plus / Family subscriptions)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_PLUS=price_...   # recurring price for the Plus (premium) tier
# STRIPE_PRICE_FAMILY=price_... # recurring price for the Family tier
# STRIPE_WEBHOOK_SECRET=whsec_... # for /api/stripe-webhook
